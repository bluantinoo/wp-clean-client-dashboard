#. Plugin Name of the plugin
msgid "WP Clean Client Dashboard"
msgstr "WP Clean Client Dashboard"

#. Description of the plugin
msgid "Hides notices, blocks updates, hides menu items and cleans the admin UI for all users except designated ones."
msgstr "Nasconde le notice, blocca gli aggiornamenti, nasconde voci di menu e pulisce l'interfaccia admin per tutti gli utenti tranne quelli designati."

#: wp-clean-client-dashboard.php
msgid "Clean Dashboard Settings"
msgstr "Impostazioni Clean Dashboard"

#: wp-clean-client-dashboard.php
msgid "Clean Dashboard"
msgstr "Clean Dashboard"

#: wp-clean-client-dashboard.php
msgid "Users excluded from restrictions"
msgstr "Utenti esclusi dalle restrizioni"

#: wp-clean-client-dashboard.php
msgid "Dashboard widgets to hide"
msgstr "Widget della dashboard da nascondere"

#: wp-clean-client-dashboard.php
msgid "Menu items to hide"
msgstr "Voci di menu da nascondere"

#: wp-clean-client-dashboard.php
msgid "Admin bar nodes to hide"
msgstr "Nodi della barra admin da nascondere"

#: wp-clean-client-dashboard.php
msgid "CSS selectors to hide"
msgstr "Selettori CSS da nascondere"

#: wp-clean-client-dashboard.php
msgid "Select dashboard widgets to hide from unauthorised users. The list is built the first time an allowed user visits the Dashboard."
msgstr "Seleziona i widget della dashboard da nascondere agli utenti non autorizzati. L'elenco viene popolato la prima volta che un utente autorizzato visita la Dashboard."

#: wp-clean-client-dashboard.php
msgid "No widgets found yet. Visit the Dashboard page once as an allowed user to populate this list."
msgstr "Nessun widget trovato. Visita la Dashboard almeno una volta come utente autorizzato per popolare questo elenco."

#: wp-clean-client-dashboard.php
msgid "The widget ID is shown in grey next to the title."
msgstr "L'ID del widget è mostrato in grigio accanto al titolo."

#: wp-clean-client-dashboard.php
msgid "Select admin bar nodes to hide from unauthorised users — on both frontend and backend."
msgstr "Seleziona i nodi della barra admin da nascondere agli utenti non autorizzati — sia nel frontend che nel backend."

#: wp-clean-client-dashboard.php
msgid "visible only in wp-admin"
msgstr "visibile solo in wp-admin"

#: wp-clean-client-dashboard.php
msgid "visible only on the site"
msgstr "visibile solo nel frontend"

#: wp-clean-client-dashboard.php
msgid "visible everywhere"
msgstr "visibile ovunque"

#: wp-clean-client-dashboard.php
msgid "The list grows automatically as you browse — visit frontend pages to discover plugin nodes that appear there."
msgstr "L'elenco cresce automaticamente mentre navighi — visita le pagine del frontend per scoprire i nodi dei plugin che appaiono lì."

#: wp-clean-client-dashboard.php
msgid "No nodes found yet. Navigate any page as an allowed user to populate this list."
msgstr "Nessun nodo trovato. Naviga qualsiasi pagina come utente autorizzato per popolare questo elenco."

#: wp-clean-client-dashboard.php
msgid "Hiding a top-level node also removes its dropdown children."
msgstr "Nascondere un nodo di primo livello rimuove anche i suoi elementi figlio nel menu a tendina."

#: wp-clean-client-dashboard.php
msgid "Select items to hide from unauthorised users. ★ = enabled by default."
msgstr "Seleziona le voci da nascondere agli utenti non autorizzati. ★ = attive di default."

#: wp-clean-client-dashboard.php
msgid "Selected users will see notices and updates as normal."
msgstr "Gli utenti selezionati vedranno notice e aggiornamenti normalmente."

#: wp-clean-client-dashboard.php
msgid "No menu items available."
msgstr "Nessuna voce di menu disponibile."

#: wp-clean-client-dashboard.php
msgid "★ = hidden by default. Checking a top-level item hides it entirely, including its sub-items."
msgstr "★ = nascosto di default. Spuntare una voce di primo livello la nasconde interamente, inclusi i sottomenu."

#: wp-clean-client-dashboard.php
msgid "One CSS selector per line. Hidden with display:none for unauthorised users."
msgstr "Un selettore CSS per riga. Verranno nascosti con display:none per gli utenti non autorizzati."

#: wp-clean-client-dashboard.php
msgid "Cleans up the WordPress admin for non-technical users. Excluded users keep full access. All other admins will have: update capabilities blocked · notices hidden · admin menu and admin bar items selectively removed · dashboard widgets hideable · Help tab suppressed · WP logo replaced with the site favicon · custom footer branding."
msgstr "Pulisce l'admin di WordPress per gli utenti non tecnici. Gli utenti esclusi mantengono l'accesso completo. Tutti gli altri admin avranno: capability di aggiornamento bloccate · notice nascoste · voci di menu e admin bar rimovibili selettivamente · widget della dashboard nascondibili · tab Aiuto soppressa · logo WP sostituito con la favicon del sito · branding nel footer personalizzato."

#: wp-clean-client-dashboard.php
msgid "Full access"
msgstr "Accesso completo"

#: wp-clean-client-dashboard.php
msgid "Restricted"
msgstr "Limitato"

#: wp-clean-client-dashboard.php
#. translators: 1: display name, 2: user ID, 3: coloured status label
msgid "You are logged in as %1$s (ID: %2$d) — %3$s"
msgstr "Sei collegato come %1$s (ID: %2$d) — %3$s"

#: wp-clean-client-dashboard.php
msgid "Save settings"
msgstr "Salva impostazioni"

#: wp-clean-client-dashboard.php
msgid "Settings imported successfully."
msgstr "Impostazioni importate con successo."

#: wp-clean-client-dashboard.php
msgid "Invalid JSON — please check your export and try again."
msgstr "JSON non valido — controlla il tuo export e riprova."

#: wp-clean-client-dashboard.php
msgid "Export / Import settings"
msgstr "Esporta / Importa impostazioni"

#: wp-clean-client-dashboard.php
msgid "Export"
msgstr "Esporta"

#: wp-clean-client-dashboard.php
msgid "Copy the JSON below to back up or transfer your settings to another site."
msgstr "Copia il JSON qui sotto per eseguire un backup o trasferire le impostazioni su un altro sito."

#: wp-clean-client-dashboard.php
msgid "Import"
msgstr "Importa"

#: wp-clean-client-dashboard.php
msgid "Paste a previously exported JSON to restore settings. This will overwrite current values."
msgstr "Incolla un JSON esportato in precedenza per ripristinare le impostazioni. I valori attuali verranno sovrascritti."

#: wp-clean-client-dashboard.php
msgid "Import settings"
msgstr "Importa impostazioni"

#: wp-clean-client-dashboard.php
msgid "Custom footer text"
msgstr "Testo footer personalizzato"

#: wp-clean-client-dashboard.php
msgid "Shown in the admin footer for restricted users. Leave empty to display no footer text."
msgstr "Mostrato nel footer admin per gli utenti con accesso limitato. Lascia vuoto per non mostrare alcun testo nel footer."

#: wp-clean-client-dashboard.php
msgid "Allowed HTML:"
msgstr "HTML consentito:"

#: wp-clean-client-dashboard.php
msgid "Preview:"
msgstr "Anteprima:"
